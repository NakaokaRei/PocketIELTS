    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to record Speaking answers or talk with an AI examiner. Voice conversations send audio to OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakingの回答録音とAI試験官との音声会話にマイクを使用します。音声会話では音声をOpenAIへ送信します。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe your recorded English responses to review your practice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音した英語の回答を文字起こしし、学習の振り返りに使います。"
          }
        }
      }
    }
