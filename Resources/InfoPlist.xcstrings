    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to record Speaking answers or talk with an AI examiner. Voice conversations send audio to OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speakingの回答録音とAI試験官との音声会話にマイクを使用します。音声会話では音声をOpenAIへ送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用麦克风录制口语回答或与AI考官对话。语音对话会将音频发送给OpenAI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用麥克風錄製口說回答或與AI考官對話。語音對話會將音訊傳送給OpenAI。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하기 답변 녹음과 AI 시험관과의 대화에 마이크를 사용합니다. 음성 대화는 오디오를 OpenAI로 전송합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el micrófono para grabar respuestas o hablar con un examinador de IA. Las conversaciones envían audio a OpenAI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o microfone para gravar respostas ou conversar com um examinador de IA. As conversas enviam áudio à OpenAI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng micrô để ghi câu trả lời hoặc trò chuyện với giám khảo AI. Cuộc trò chuyện gửi âm thanh tới OpenAI."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon digunakan untuk merekam jawaban atau berbicara dengan penguji AI. Percakapan mengirim audio ke OpenAI."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไมโครโฟนอัดคำตอบหรือคุยกับผู้สอบ AI การสนทนาจะส่งเสียงให้ OpenAI"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तर रिकॉर्ड करने या AI परीक्षक से बात करने के लिए माइक्रोफ़ोन इस्तेमाल होता है। बातचीत का ऑडियो OpenAI को भेजा जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم الميكروفون لتسجيل الإجابات أو التحدث مع ممتحن ذكاء اصطناعي. ترسل المحادثات الصوت إلى OpenAI."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe your recorded English responses to review your practice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音した英語の回答を文字起こしし、学習の振り返りに使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将录制的英语回答转写为文字，用于学习回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將錄製的英語回答轉寫為文字，以便複習。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음한 영어 답변을 글로 옮겨 학습을 돌아봅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe tus respuestas grabadas en inglés para revisar tu práctica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreva suas respostas gravadas em inglês para revisar a prática."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời câu trả lời tiếng Anh đã ghi để xem lại bài luyện."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsikan rekaman jawaban Inggris untuk meninjau latihan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถอดเสียงคำตอบภาษาอังกฤษที่อัดไว้เพื่อทบทวนการฝึก"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास की समीक्षा के लिए रिकॉर्ड किए अंग्रेज़ी उत्तरों का प्रतिलेखन करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفريغ إجاباتك المسجلة بالإنجليزية لمراجعة التدريب."
          }
        }
      }
    }
  },
  "version": "1.0"
}
