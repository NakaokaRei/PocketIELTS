    "正解はまだ言わず、この問題を自分で解くためのヒントを一つください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me one hint to help solve this question myself, without revealing the answer yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解はまだ言わず、この問題を自分で解くためのヒントを一つください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请给我一个解题提示，先不要透露正确答案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請給我一個解題提示，先不要透露正確答案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답을 바로 알려주지 말고 스스로 풀 수 있도록 힌트를 하나 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame una pista para resolver esta pregunta sin revelar aún la respuesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma dica para eu resolver esta questão sem revelar a resposta ainda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho một gợi ý để tôi tự giải câu này, chưa tiết lộ đáp án."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri satu petunjuk agar saya bisa menjawab sendiri, tanpa mengungkap jawabannya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอคำใบ้หนึ่งข้อให้ฉันลองตอบเอง โดยยังไม่เฉลยคำตอบ"
