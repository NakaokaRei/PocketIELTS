          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích nghĩa của cụm từ hoặc câu đã chọn trong ngữ cảnh này bằng tiếng Việt đơn giản."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan arti ungkapan atau kalimat terpilih dalam konteks ini dengan bahasa Indonesia sederhana."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายความหมายของสำนวนหรือประโยคที่เลือกในบริบทนี้ด้วยภาษาไทยง่าย ๆ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने वाक्यांश या वाक्य का इस संदर्भ में अर्थ सरल हिंदी में समझाएँ।"
