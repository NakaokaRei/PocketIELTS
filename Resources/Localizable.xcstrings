    "iCloudにサインインしてください。データはこの端末に保存されています。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to sync. Your data is saved on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしてください。データはこの端末に保存されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录iCloud以同步。数据已保存在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請登錄iCloud以同步。資料已保存在本機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인하세요. 데이터는 이 기기에 저장되어 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para sincronizar. Tus datos están guardados en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no iCloud para sincronizar. Seus dados estão salvos neste dispositivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập iCloud để đồng bộ. Dữ liệu đã lưu trên thiết bị này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke iCloud untuk sinkronisasi. Data tersimpan di perangkat ini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ iCloud เพื่อซิงค์ ข้อมูลบันทึกไว้ในอุปกรณ์นี้แล้ว"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक करने के लिए iCloud में साइन इन करें। डेटा इस डिवाइस पर सुरक्षित है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud للمزامنة. بياناتك محفوظة على هذا الجهاز."
          }
        }
      }
    },
