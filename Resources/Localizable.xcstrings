        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成所需时间稍长，请留在此页面等待完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成所需時間稍長，請留在此頁面等待完成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성에 시간이 더 걸리고 있습니다. 완료될 때까지 이 화면에서 기다려 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación está tardando un poco más. Quédate en esta pantalla hasta que termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geração está demorando um pouco mais. Aguarde nesta tela até terminar."
