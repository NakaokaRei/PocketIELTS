    "Study levels are a guide, not official IELTS word lists.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Study levels are a guide, not official IELTS word lists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルは学習の目安です。IELTS公式の単語リストではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "级别仅供学习参考，并非IELTS官方词表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "級別僅供學習參考，並非IELTS官方單字表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수준은 학습 참고용이며 IELTS 공식 단어 목록이 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niveles son orientativos, no listas oficiales de IELTS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os níveis são orientativos, não listas oficiais do IELTS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cấp độ chỉ để tham khảo, không phải danh sách từ chính thức của IELTS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat ini hanya panduan belajar, bukan daftar kata resmi IELTS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับเป็นแนวทางการเรียน ไม่ใช่รายการคำศัพท์อย่างเป็นทางการของ IELTS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्तर सीखने के मार्गदर्शक हैं, IELTS की आधिकारिक शब्द सूचियाँ नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستويات دليل للتعلّم وليست قوائم مفردات رسمية لاختبار IELTS."
          }
        }
      }
    },
    "12 included parts. Reading answers and explanations work offline. AI feedback, conversations and new audio need internet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12 included parts. Reading answers and explanations work offline. AI feedback, conversations and new audio need internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全12パートを収録。Readingの採点・解説はオフラインで利用できます。AI講評・会話・新しい音声の生成には通信が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置12个部分。阅读答案和解析可离线使用。AI反馈、对话和新音频需要联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建12個部分。閱讀答案和解析可離線使用。AI講評、對話及新音訊需要連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12개 파트가 포함되어 있습니다. Reading 정답과 해설은 오프라인으로 이용할 수 있습니다. AI 피드백, 대화, 새 음성 생성에는 인터넷이 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye 12 partes. Las respuestas y explicaciones de Reading funcionan sin conexión. Los comentarios de IA, las conversaciones y el audio nuevo requieren internet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui 12 partes. Respostas e explicações de Reading funcionam offline. Feedback de IA, conversas e novos áudios precisam de internet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sẵn 12 phần. Đáp án và giải thích Reading dùng được ngoại tuyến. Nhận xét AI, hội thoại và âm thanh mới cần internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersedia 12 bagian. Jawaban dan penjelasan Reading dapat digunakan offline. Umpan balik AI, percakapan, dan audio baru memerlukan internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเนื้อหา 12 พาร์ต คำตอบและคำอธิบาย Reading ใช้งานออฟไลน์ได้ ข้อเสนอแนะจาก AI การสนทนา และเสียงใหม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "12 भाग शामिल हैं। Reading के उत्तर और व्याख्याएँ ऑफ़लाइन उपलब्ध हैं। AI प्रतिक्रिया, बातचीत और नए ऑडियो के लिए इंटरनेट चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن 12 جزءًا. تعمل إجابات Reading وشروحاتها دون اتصال. تتطلب ملاحظات الذكاء الاصطناعي والمحادثات والصوت الجديد اتصالًا بالإنترنت."
          }
        }
      }
    },
