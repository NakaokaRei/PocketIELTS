        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API de voz é inválida. Salve uma chave válida em Ajustes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API giọng nói không hợp lệ. Lưu khóa hợp lệ trong Cài đặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
