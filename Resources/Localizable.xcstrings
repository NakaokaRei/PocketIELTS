    "本文や解説を長押しして表現を追加できます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a word or hold to select a phrase in passages and explanations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文や解説を長押しして表現を追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击单词或长按选取文章、解析中的表达即可保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊單字或長按選取文章、解析中的表達即可保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문이나 해설에서 단어를 누르거나 길게 눌러 표현을 선택할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una palabra o mantén pulsado para seleccionar una expresión en textos y explicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma palavra ou mantenha pressionado para selecionar expressões nos textos e explicações."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào từ hoặc nhấn giữ để chọn cụm từ trong bài đọc và giải thích."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kata atau tekan lama untuk memilih ungkapan dalam teks dan penjelasan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะคำหรือกดค้างเพื่อเลือกสำนวนในบทอ่านและคำอธิบาย"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठ या व्याख्या में शब्द टैप करें या वाक्यांश चुनने के लिए दबाए रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على كلمة أو اضغط مطولًا لتحديد تعبير في النصوص والشروحات."
          }
        }
      }
    },
