        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が遅いため会話を停止しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接太慢，对话已停止。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接太慢，對話已停止。請重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 느려 대화를 중지했습니다. 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión es demasiado lenta. Se detuvo la conversación. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão está lenta demais. A conversa foi interrompida. Tente novamente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối quá chậm nên cuộc trò chuyện đã dừng. Vui lòng thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi terlalu lambat, percakapan dihentikan. Coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อช้าเกินไปจึงหยุดบทสนทนา โปรดลองใหม่"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीमे कनेक्शन के कारण बातचीत रुकी। फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال بطيء جدًا، لذا توقفت المحادثة. حاول مجددًا."
          }
        }
      }
    },
    "一部の音声を文字起こしできませんでした。回答を確認・修正してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some speech could not be transcribed. Please review and edit your answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の音声を文字起こしできませんでした。回答を確認・修正してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
