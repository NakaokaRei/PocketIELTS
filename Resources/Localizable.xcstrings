    "キーチェーンにアクセスできません。iPhoneのロックを解除して再試行してください。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى سلسلة المفاتيح. افتح قفل الجهاز وحاول مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot access the Keychain. Unlock your device and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al llavero. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain नहीं खुल सका। डिवाइस अनलॉक करके फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mengakses Keychain. Buka kunci perangkat lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンにアクセスできません。iPhoneのロックを解除して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인에 접근할 수 없습니다. 기기 잠금을 해제하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar as Chaves. Desbloqueie o dispositivo e tente novamente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข้าถึงพวงกุญแจไม่ได้ โปรดปลดล็อกอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể truy cập Chuỗi khóa. Mở khóa thiết bị rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问钥匙串。请解锁设备后重试。"
