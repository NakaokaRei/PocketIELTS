    "この表現の使い方と、よく一緒に使う語を例文付きで教えてください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この表現の使い方と、よく一緒に使う語を例文付きで教えてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain how to use this expression and its common collocations, with examples."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用例句说明此表达的用法及常见搭配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用例句說明此表達的用法及常見搭配。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 표현의 사용법과 자주 함께 쓰이는 단어를 예문으로 설명해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica cómo usar esta expresión y sus combinaciones habituales, con ejemplos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique o uso desta expressão e suas combinações comuns, com exemplos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích cách dùng cụm từ này và các từ thường đi cùng, kèm ví dụ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan penggunaan ungkapan ini dan padanan kata yang umum menyertainya, dengan contoh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายวิธีใช้สำนวนนี้และคำที่มักใช้ร่วมกัน พร้อมตัวอย่าง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वाक्यांश का उपयोग और इसके साथ आने वाले सामान्य शब्द उदाहरण सहित समझाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرح استخدام هذا التعبير والكلمات الشائعة معه، مع أمثلة."
          }
        }
      }
    },
