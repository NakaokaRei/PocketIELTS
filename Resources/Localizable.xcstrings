          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API เสียงไม่ถูกต้อง บันทึกคีย์ที่ถูกต้องในการตั้งค่า"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस API कुंजी मान्य नहीं है। सेटिंग में सही कुंजी सहेजें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API الصوت غير صالح. احفظ مفتاحًا صالحًا في الإعدادات."
          }
        }
      }
    },
    "音声APIの残高または利用枠が不足しています。APIの利用状況を確認してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice API credits or quota are exhausted. Check your API usage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声APIの残高または利用枠が不足しています。APIの利用状況を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音API余额或额度不足，请检查API用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音API餘額或額度不足，請檢查API用量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 API 잔액 또는 한도가 부족합니다. API 사용량을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan créditos o cuota de API de voz. Comprueba el uso de API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os créditos ou a cota da API de voz acabaram. Confira o uso da API."
          }
