        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc tạo bài đang mất thêm thời gian. Vui lòng chờ ở màn hình này đến khi xong."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuatan butuh waktu lebih lama. Tunggu di layar ini sampai selesai."
