    "キーチェーンにアクセスできません。iPhoneのロックを解除して再試行してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot access the Keychain. Unlock your device and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンにアクセスできません。iPhoneのロックを解除して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问钥匙串。请解锁设备后重试。"
