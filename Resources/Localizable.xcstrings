    "音声接続が切れました。接続状況とAPI設定を確認してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice connection was lost. Check your connection and API settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声接続が切れました。接続状況とAPI設定を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音连接已断开，请检查网络和API设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音連接已斷開，請檢查網絡和API設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 연결이 끊겼습니다. 연결과 API 설정을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión de voz. Comprueba la conexión y los ajustes de API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão de voz caiu. Verifique a conexão e os ajustes de API."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất kết nối giọng nói. Kiểm tra kết nối và cài đặt API."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi suara terputus. Periksa koneksi dan pengaturan API."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อเสียงหลุด ตรวจสอบการเชื่อมต่อและการตั้งค่า API"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ का कनेक्शन टूट गया। कनेक्शन और API सेटिंग जाँचें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال الصوتي. افحص الاتصال وإعدادات API."
          }
        }
      }
    },
    "音声接続がタイムアウトしました。もう一度お試しください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice connection timed out. Please try again."
