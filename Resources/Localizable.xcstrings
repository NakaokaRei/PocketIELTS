    "選択した英文の文法と文の構造を、主語・動詞などに分けて説明してください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain the grammar and structure of the selected English sentence, identifying the subject, verb and other parts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した英文の文法と文の構造を、主語・動詞などに分けて説明してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分析所选英文句子的语法和结构，标出主语、动词等成分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請分析所選英文句子的語法和結構，標出主語、動詞等成分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 영문장의 문법과 구조를 주어·동사 등으로 나누어 설명해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica la gramática y estructura de la frase inglesa seleccionada, identificando sujeto, verbo y demás elementos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique a gramática e a estrutura da frase em inglês selecionada, identificando sujeito, verbo e demais elementos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích ngữ pháp và cấu trúc câu tiếng Anh đã chọn, xác định chủ ngữ, động từ và các thành phần khác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan tata bahasa dan struktur kalimat Inggris terpilih, termasuk subjek, kata kerja, dan bagian lainnya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายไวยากรณ์และโครงสร้างประโยคอังกฤษที่เลือก โดยแยกประธาน กริยา และส่วนอื่น ๆ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने अंग्रेज़ी वाक्य का व्याकरण और ढाँचा समझाएँ, जिसमें कर्ता, क्रिया और अन्य भागों की पहचान हो।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرح قواعد الجملة الإنجليزية المحددة وبنيتها، مع تحديد الفاعل والفعل وبقية الأجزاء."
          }
        }
      }
    },
    "選択した表現の自然な言い換えと、英語の例文を2つ、日本語訳付きで教えてください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me natural alternatives to the selected expression and two English example sentences with simple explanations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した表現の自然な言い換えと、英語の例文を2つ、日本語訳付きで教えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请给出所选表达的自然改写，以及两个英文例句和中文翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請給出所選表達的自然改寫，以及兩個英文例句和中文翻譯。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 표현의 자연스러운 바꿔 쓰기와 영어 예문 두 개를 한국어 번역과 함께 알려 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame alternativas naturales a la expresión seleccionada y dos frases de ejemplo en inglés con traducción al español."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê alternativas naturais para a expressão selecionada e duas frases de exemplo em inglês com tradução para o português."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho cách diễn đạt tự nhiên khác và hai câu ví dụ tiếng Anh kèm bản dịch tiếng Việt cho cụm từ đã chọn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan ungkapan alternatif yang alami dan dua kalimat contoh bahasa Inggris beserta terjemahan bahasa Indonesia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้สำนวนอื่นที่เป็นธรรมชาติและประโยคตัวอย่างภาษาอังกฤษสองประโยค พร้อมคำแปลภาษาไทย"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने वाक्यांश के सहज विकल्प और दो अंग्रेज़ी उदाहरण हिंदी अनुवाद के साथ दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطني بدائل طبيعية للتعبير المحدد وجملتين بالإنجليزية مع ترجمة عربية."
          }
        }
      }
    },
    "選択した表現や文の、この文脈での意味をやさしい日本語で教えてください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain the meaning of the selected expression or sentence in this context using simple English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した表現や文の、この文脈での意味をやさしい日本語で教えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用简单的中文解释所选表达或句子在当前语境中的意思。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用簡單的中文解釋所選表達或句子在當前語境中的意思。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 표현이나 문장의 문맥상 의미를 쉬운 한국어로 설명해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica en español sencillo el significado de la expresión o frase seleccionada en este contexto."
