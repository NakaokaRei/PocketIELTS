    "もう少し時間がかかっています。完了までこの画面でお待ちください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation is taking a little longer. Please stay on this screen until it finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し時間がかかっています。完了までこの画面でお待ちください。"
